{
  "name": "pi-workbench",
  "version": "0.4.1",
  "description": "Sreeram's preference-aware Pi workbench for planning, research, delegated implementation, verification, durable agent memory, and trusted skill evolution.",
  "private": true,
  "type": "module",
  "author": "Sreeram Balamurugan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsreeram08/pi-workbench.git"
  },
  "homepage": "https://github.com/bsreeram08/pi-workbench#readme",
  "bugs": {
    "url": "https://github.com/bsreeram08/pi-workbench/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "multi-agent",
    "agent-memory",
    "research",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test tests",
    "typecheck": "node scripts/typecheck.mjs",
    "public-check": "node scripts/check-public-release.mjs",
    "release-check": "node scripts/check-public-release.mjs --history && bun audit --audit-level=high && bun run test && bun run typecheck",
    "check": "bun run public-check && bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
